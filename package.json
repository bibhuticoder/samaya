{
  "name": "samaya",
  "version": "2.0.0",
  "type": "module",
  "description": "Samaya - Friendly personal dashboard featuring Nepali calendar, daily Nepali quotes & Nepali wallpapers",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:chrome": "vite build --config vite.config.chrome.ts",
    "build:firefox": "vite build --config vite.config.firefox.ts",
    "build:extension": "npm run build:chrome && npm run build:firefox",
    "build:all": "npm run build && npm run build:extension"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "nepali-date-converter": "^3.4.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
